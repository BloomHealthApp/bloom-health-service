{
  "habits": [
    {"id": "water", "trackingType": "quantity", "target": 2000, "comparison": "atLeast", "active": true},
    {"id": "sugar", "trackingType": "boolean", "target": 1, "comparison": "atLeast", "active": true},
    {"id": "wake", "trackingType": "timeOfDay", "target": 300, "comparison": "by", "active": true},
    {"id": "walk", "trackingType": "boolean", "target": 1, "comparison": "atLeast", "days": [4], "active": true},
    {"id": "old", "trackingType": "boolean", "target": 1, "comparison": "atLeast", "active": false}
  ],
  "cases": [
    {
      "name": "three perfect days then a miss",
      "settings": {"threshold": 80, "restDays": [], "restMode": "neutral"},
      "from": "2026-10-05", "to": "2026-10-09", "today": "2026-10-09",
      "logs": {
        "2026-10-05": {"water": {"value": 2000}, "sugar": {"value": 1}, "wake": {"value": 295}, "walk": {"value": 1}},
        "2026-10-06": {"water": {"value": 2500}, "sugar": {"value": 1}, "wake": {"value": 300}},
        "2026-10-07": {"water": {"value": 2000}, "sugar": {"value": 1}, "wake": {"value": 240}, "walk": {"value": 1}},
        "2026-10-08": {"water": {"value": 500}, "sugar": {"value": 0}, "wake": {"value": 400}},
        "2026-10-09": {"water": {"value": 2000}, "sugar": {"value": 1}, "wake": {"value": 290}, "walk": {"value": 1}}
      },
      "expect": {"current": 1, "longest": 3, "percents": {"2026-10-05": 100, "2026-10-06": 100, "2026-10-07": 100, "2026-10-08": 0, "2026-10-09": 100}}
    },
    {
      "name": "unlogged day breaks streak; today in progress does not",
      "settings": {"threshold": 80, "restDays": [], "restMode": "neutral"},
      "from": "2026-10-05", "to": "2026-10-08", "today": "2026-10-08",
      "logs": {
        "2026-10-05": {"water": {"value": 2000}, "sugar": {"value": 1}, "wake": {"value": 300}},
        "2026-10-07": {"water": {"value": 2000}, "sugar": {"value": 1}, "wake": {"value": 300}},
        "2026-10-08": {"water": {"value": 100}}
      },
      "expect": {"current": 1, "longest": 1, "percents": {"2026-10-05": 100, "2026-10-06": 0, "2026-10-07": 100, "2026-10-08": 0}}
    },
    {
      "name": "neutral rest day neither breaks nor extends",
      "settings": {"threshold": 80, "restDays": [0], "restMode": "neutral"},
      "from": "2026-10-09", "to": "2026-10-13", "today": "2026-10-13",
      "logs": {
        "2026-10-09": {"water": {"value": 2000}, "sugar": {"value": 1}, "wake": {"value": 300}},
        "2026-10-10": {"water": {"value": 2000}, "sugar": {"value": 1}, "wake": {"value": 300}},
        "2026-10-12": {"water": {"value": 2000}, "sugar": {"value": 1}, "wake": {"value": 300}},
        "2026-10-13": {"water": {"value": 2000}, "sugar": {"value": 1}, "wake": {"value": 300}}
      },
      "expect": {"current": 4, "longest": 4, "percents": {}}
    },
    {
      "name": "rest day counts mode extends streak",
      "settings": {"threshold": 80, "restDays": [0], "restMode": "counts"},
      "from": "2026-10-09", "to": "2026-10-12", "today": "2026-10-12",
      "logs": {
        "2026-10-09": {"water": {"value": 2000}, "sugar": {"value": 1}, "wake": {"value": 300}},
        "2026-10-10": {"water": {"value": 2000}, "sugar": {"value": 1}, "wake": {"value": 300}},
        "2026-10-12": {"water": {"value": 2000}, "sugar": {"value": 1}, "wake": {"value": 300}}
      },
      "expect": {"current": 4, "longest": 4, "percents": {}}
    },
    {
      "name": "skipped and partial habits; scheduled weekdays; threshold",
      "settings": {"threshold": 66, "restDays": [], "restMode": "neutral"},
      "from": "2026-10-12", "to": "2026-10-13", "today": "2026-10-13",
      "logs": {
        "2026-10-12": {"water": {"value": 1000}, "sugar": {"status": "skipped"}, "wake": {"value": 300}, "walk": {"value": 1}},
        "2026-10-13": {"water": {"value": 2000}, "sugar": {"value": 1}, "wake": {"value": 301}}
      },
      "expect": {"current": 1, "longest": 1, "percents": {"2026-10-12": 50, "2026-10-13": 66.67}}
    }
  ]
}
