# Copy to deploy/k8s/.env.secrets (gitignored) and fill in the SAME values the Vercel deployment uses, so both
# hosts share the database and already-issued sessions stay valid. secrets.sh loads this file into the cluster.
# Never commit the filled-in copy.

# --- required ---
MONGODB_URI=
ACCESS_TOKEN_SECRET=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Bloom Health <no-reply@example.com>

# --- optional (leave empty to keep the feature off) ---
SMTP_PORT=587
INTERNAL_API_SECRET=
GOOGLE_CLIENT_ID=
REVIEW_LOGIN_EMAIL=
REVIEW_LOGIN_CODE=
CHAT_DAILY_MESSAGE_CAP=
LOG_LEVEL=info
# OpenTelemetry export (needs the observability change; off when empty), e.g. Grafana Cloud's OTLP endpoint and its Authorization header
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
