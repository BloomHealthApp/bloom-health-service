APP_ENV=development
PORT=3000
# mongo | memory (memory = ephemeral, dev only; auto-seeds OWNER/VIEWER emails below at start)
STORE=mongo
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER/?retryWrites=true&w=majority
MONGODB_DB=bubu_bloom
# >= 32 random chars, e.g. `openssl rand -base64 48`
ACCESS_TOKEN_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_32_CHARS_MIN
AUTH_ISSUER=bubu-bloom
# console (dev: prints OTP to logs) | smtp (required in production)
MAILER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Bubu Bloom <no-reply@example.com>
# set true only behind a trusted reverse proxy (uses X-Forwarded-For for rate limits)
TRUST_PROXY=false
# Invite-only provisioning (go run ./cmd/seed)
OWNER_EMAIL=anu@example.com
OWNER_NAME=Anu
VIEWER_EMAIL=aman@example.com
VIEWER_NAME=Aman
DEFAULT_TIMEZONE=Asia/Kolkata
