# Selects assets/{dev,stag,prod}-config.json. DEV | STAG | PROD
ACTIVE_ENV=DEV
# Everything below overrides the JSON config; the secrets (marked) may ONLY come from the environment.
PORT=3000
# mongo | memory (memory = ephemeral, dev only)
STORE=memory
# SECRET
MONGODB_URI=
MONGODB_DB=bubu_bloom
# SECRET, >= 32 random chars, e.g. `openssl rand -base64 48`
ACCESS_TOKEN_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_32_CHARS_MIN
AUTH_ISSUER=bubu-bloom
# console (dev: prints OTP to logs) | smtp (required when ACTIVE_ENV=PROD)
MAILER=console
SMTP_HOST=
SMTP_PORT=587
# SECRET
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Bubu Bloom <no-reply@example.com>
# set true only behind a trusted reverse proxy (uses X-Forwarded-For for rate limits)
TRUST_PROXY=false
# comma-separated browser origins allowed by CORS (empty = no CORS headers)
CORS_ORIGINS=
LOG_LEVEL=debug
# Timezone assigned to new accounts until the app reports the device timezone
DEFAULT_TIMEZONE=Asia/Kolkata
